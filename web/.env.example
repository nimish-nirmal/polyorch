# Runtime config is handled by web/public/config.js (loaded before the app).
# To use a remote backend (e.g. GitHub Pages), set:
#   APP_API_URL=https://your-backend.com
#   APP_WS_URL=wss://your-backend.com
# as GitHub repository secrets — the CI workflow generates config.js at build time.
#
# Legacy Vite env vars (build-time, override config.js if set):
VITE_API_URL=
VITE_WS_URL=
